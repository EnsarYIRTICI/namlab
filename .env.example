# Kopyalayın: cp .env.example .env  ve CHANGE_ME olanları doldurun.
# Güçlü değer üretmek için: openssl rand -base64 24

# Tarayıcıdan erişilen tam adres (CSRF koruması bununla çalışır)
APP_ORIGIN=https://namlab.xenny.cloud

POSTGRES_USER=namlab
POSTGRES_DB=namlab
POSTGRES_PASSWORD=CHANGE_ME

# İlk açılışta hiç kullanıcı yoksa bu hesap yönetici olarak oluşturulur (sonra ADMIN_PASSWORD satırını silin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_EN_AZ_10_KARAKTER

# WEB_PORT=3300
# API_PORT=4300
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
